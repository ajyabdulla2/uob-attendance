  "fixed_sql": [
    {
      "name": "local_students",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"local_students\" (\"id\" TEXT NOT NULL, \"university_id\" TEXT NOT NULL, \"full_name\" TEXT NOT NULL, \"stage_id\" TEXT NOT NULL, \"section\" TEXT NOT NULL DEFAULT '', \"status\" TEXT NOT NULL, \"carry_over\" INTEGER NOT NULL DEFAULT 0 CHECK (\"carry_over\" IN (0, 1)), \"sort_key\" TEXT NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "local_courses",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"local_courses\" (\"id\" TEXT NOT NULL, \"code\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"stage_id\" TEXT NOT NULL, \"semester\" INTEGER NOT NULL, \"units\" INTEGER NOT NULL, \"has_practical\" INTEGER NOT NULL CHECK (\"has_practical\" IN (0, 1)), PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "local_groups",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"local_groups\" (\"id\" TEXT NOT NULL, \"course_id\" TEXT NOT NULL, \"stage_id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"student_ids_json\" TEXT NOT NULL DEFAULT '[]', PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "local_assignments",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"local_assignments\" (\"id\" TEXT NOT NULL, \"teacher_id\" TEXT NOT NULL, \"course_id\" TEXT NOT NULL, \"stage_id\" TEXT NOT NULL, \"type\" TEXT NOT NULL, \"target\" TEXT NOT NULL, \"group_id\" TEXT NULL, \"course_name\" TEXT NOT NULL DEFAULT '', \"teacher_name\" TEXT NOT NULL DEFAULT '', PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "outbox_entries",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"outbox_entries\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"batch_id\" TEXT NOT NULL, \"op\" TEXT NOT NULL, \"path\" TEXT NOT NULL, \"payload_json\" TEXT NOT NULL DEFAULT '{}', \"created_at\" INTEGER NOT NULL, \"attempts\" INTEGER NOT NULL DEFAULT 0, \"last_error\" TEXT NULL);"
        }
      ]
    },
    {
      "name": "sync_states",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"sync_states\" (\"key\" TEXT NOT NULL, \"value\" TEXT NOT NULL, PRIMARY KEY (\"key\"));"
        }
      ]
    }
